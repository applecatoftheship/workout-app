{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/self-review-mark-dirty.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/self-review-trigger.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "checker",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/checker-record.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "checker",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/checker-start.sh"
          }
        ]
      }
    ]
  }
}
